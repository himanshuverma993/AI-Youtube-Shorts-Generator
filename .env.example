# Groq free tier — powers transcription (Whisper) AND is the PRIMARY LLM
# for highlight/metadata generation.
# Create a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# OPTIONAL but recommended — Cerebras free tier as AUTOMATIC LLM FALLBACK.
# If Groq's LLM hard-fails (outage, quota exhausted, bad key), the same
# prompt is replayed on Cerebras so the campaign never stops. No credit
# card; 1M free tokens/day. Create a key at https://cloud.cerebras.ai
# (Note: transcription stays on Groq — Cerebras has no free Whisper.)
# CEREBRAS_API_KEY=csk_your_cerebras_key_here
CEREBRAS_LLM_MODEL=llama-3.3-70b
# LLM_FALLBACK=true
# LLM_CIRCUIT_BREAK_SECONDS=300

# Local Whisper fallback — ON by default. If Groq Whisper dies mid-run, audio
# is transcribed on this machine's CPU instead (slower, but zero API needed).
# LOCAL_WHISPER_MODEL=small        # tiny / base / small / medium
# LOCAL_WHISPER_DEVICE=cpu
# WHISPER_FALLBACK=true
# WHISPER_CIRCUIT_BREAK_SECONDS=300

# Tier-3 LOCAL LLM (doomsday mode) — ON by default. When Groq AND Cerebras
# are both down/absent, every LLM call replays on a small instruct model on
# this machine's CPU (~3–8 min/call on 4 cores). Zero keys, zero money.
# LOCAL_LLM=true
# LOCAL_LLM_REPO=bartowski/Qwen2.5-3B-Instruct-GGUF
# LOCAL_LLM_FILE=Qwen2.5-3B-Instruct-Q4_K_M.gguf
# LOCAL_LLM_DIR=models
# LOCAL_LLM_CTX=16384
# LOCAL_LLM_MAX_TOKENS=2048

# --- 100%-local sovereignty mode (OPTIONAL) --------------------------------
# Set either provider to "local" and THAT backend will never touch a cloud
# API — every prompt / every audio second runs on this machine's CPU, even if
# a cloud key exists. "auto" = cloud-first with local failover (unchanged).
# WHISPER_PROVIDER=local     # whisper small on CPU (~25-40 min per 2h podcast)
# LLM_PROVIDER=local         # Qwen2.5-3B GGUF on CPU (~3-8 min per LLM call)

# Trend context (OPTIONAL, off until CAMPAIGN_NICHE is set) — injects a
# "what's working right now" block (keyless yt-dlp search + Google Trends RSS)
# into highlight/metadata prompts as framing bias only. Cached 24h.
# CAMPAIGN_NICHE=ai startup podcast
# TREND_CONTEXT=true
# TRENDS_GEO=IN
# TREND_CACHE_HOURS=24
# TREND_MAX_ITEMS=10

# Channel feedback loop (Phase 2, OPTIONAL — off until the OAuth trio exists).
# One-time: python scripts/oauth_local_setup.py --client-id X --client-secret Y
# (verified plan: free YouTube Analytics read, no billing). Register each posted
# clip with: python scripts/register_post.py --url <yt-link> --clip-path <clip.mp4>
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx
# YT_REFRESH_TOKEN=xxxxxxxx
# FEEDBACK=true
# FEEDBACK_MIN_POSTS=5
# FEEDBACK_MIN_AGE_HOURS=48

# YouTube auto-upload (Phase 3, OFF by default). Same OAuth trio as feedback
# (token must include youtube.upload scope — re-run oauth_local_setup.py if it
# was minted earlier). Safe ladder: privacy starts at "private".
# UPLOAD_ENABLED=false
# UPLOAD_MAX_PER_RUN=3
# YT_PRIVACY=private              # private / unlisted / public
# YT_CATEGORY_ID=22               # 22 = People & Blogs
# UPLOAD_DAILY_CAP=6
# UPLOAD_MAX_ATTEMPTS=3

# Instagram Reels upload + insights (Phase 4, OFF by default — transparent
# requirements: IG Business/Creator account + linked FB Page + FB Developer
# app). Seed one 60-day long-lived user token; with IG_APP_ID/SECRET set, the
# runner rolls it forward automatically. Repo must be PUBLIC (release staging).
# IG_UPLOAD_ENABLED=false
# IG_ACCESS_TOKEN=EAA…            # long-lived user token (60-day seed)
# IG_USER_ID=1784…                # IG business-account id
# IG_APP_ID=…                     # recommended (rolling refresh)
# IG_APP_SECRET=…
# IG_UPLOAD_MAX_PER_RUN=3
# IG_FEEDBACK_ENABLED=true

# Optional overrides (defaults shown)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=300
GROQ_MAX_RETRIES=5
# GROQ_MAX_AUDIO_BYTES=25165824
# AUDIO_CHUNK_SECONDS=600

OUTPUT_DIR=output

# FTC compliance — appended to EVERY generated description (in code).
FTC_DISCLOSURE_TAGS="#ad #sponsored"
